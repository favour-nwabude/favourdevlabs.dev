---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About & Specs — Favour Nwabude" description="Android Systems Consultant profile, Termux development environment, and core technical discipline." />
	</head>
	<body>
		<Header />
		<main>
			<section class="stoic-hero">
				<blockquote class="stoic-quote">
					"WELL-BEING IS REALIZED BY SMALL STEPS, BUT IS TRULY NO SMALL THING ITSELF."
					<footer>— ZENO OF CITIUM</footer>
				</blockquote>
				<h1>Favour Nwabude</h1>
				<p class="subtitle">ANDROID CONSULTANT | SYSTEMS ENGINEER</p>
			</section>

			<hr />

			<section>
				<h2>OPERATING SPECIFICATIONS</h2>
				<p>
					I am an Android consultant and systems engineer. Over three years, I have engineered production Android software, performed low-level debugging, and audited security codebases entirely on-device using custom mobile terminal environments—without relying on traditional IDE bloat or external desktop hardware.
				</p>
				<p>
					This discipline enforces an intimate understanding of Linux system calls, POSIX environments, build toolchains, and runtime memory limits.
				</p>
			</section>

			<hr />

			<section>
				<h2>ENVIRONMENT & TOOLCHAIN</h2>
				<ul class="discipline-list">
					<li><strong>Primary Host Environment:</strong> Containerized Termux (`pd-ubuntu`) running on ARM64 Linux hardware.</li>
					<li><strong>Code & Compilation Toolchain:</strong> Neovim, Git, Node.js v22.23.3, Astro 5, Kotlin JVM Toolchain, and Gradle.</li>
					<li><strong>Consulting Direct Path:</strong> Available globally for architecture audits, performance tuning, and low-level Android fixes.</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

