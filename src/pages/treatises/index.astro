---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished, formatDate, readingMinutes } from '../../lib/treatises';

const posts = await getPublished();
---

<BaseLayout
  title="Treatises — FavourDevLabs"
  description="Android internals, Linux and the JVM, broken down to first principles in plain language."
>
  <header class="page-head">
    <p class="section-label">Treatises</p>
    <h1>Systems, from first principles</h1>
    <p class="treatises-lede">
      Android internals, Linux and the JVM, broken down in plain language.
    </p>
    <p class="feed-links"><a class="work-link" href="/rss.xml">Subscribe by RSS</a></p>
  </header>

  {
    posts.length > 0 ? (
      <ul class="treatise-feed">
        {posts.map((post) => (
          <li>
            <a href={`/treatises/${post.id}/`}>
              <span class="feed-meta">
                <span>{formatDate(post.data.pubDate)}</span>
                <span>{readingMinutes(post.body)} min read</span>
                {post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}
                {post.data.draft && <span class="badge">Draft</span>}
              </span>
              <span class="feed-title">{post.data.title}</span>
              <span class="feed-desc">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="feed-empty">The first treatise is being written.</p>
    )
  }
</BaseLayout>
