---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('treatises')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Treatises — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="stoic-hero">
				<blockquote class="stoic-quote">
					"DO NOT ACT AS IF YOU WERE GOING TO LIVE TEN THOUSAND YEARS. DEATH HANGS OVER YOU. WHILE YOU LIVE, WHILE IT IS IN YOUR POWER, BE GOOD."
					<footer>— MARCUS AURELIUS</footer>
				</blockquote>
				<h1>Systems Treatises</h1>
				<p class="mission-statement">
					OUR TREATISES EXIST TO BREAK COMPLEX SYSTEMS DOWN TO FIRST PRINCIPLES. WE STRIP AWAY INDUSTRIAL JARGON, OBFUSCATION, AND PRETENSION TO EXPLAIN LOW-LEVEL ARCHITECTURE IN PLAIN, ACCESSIBLE LANGUAGE.
				</p>
			</section>

			<hr />

			<section>
				<ul class="treatise-archive-list">
					{
						posts.map((post) => (
							<li>
								<div class="post-meta">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<a href={`/treatises/${post.id}/`}>
									<h2 class="post-title">{post.data.title}</h2>
								</a>
								<p class="post-desc">{post.data.description}</p>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

