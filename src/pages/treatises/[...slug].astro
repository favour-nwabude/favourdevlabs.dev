---
import { render } from 'astro:content';
import TreatiseLayout from '../../layouts/TreatiseLayout.astro';
import { getPublished, readingMinutes } from '../../lib/treatises';

export async function getStaticPaths() {
  const posts = await getPublished();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] && { id: posts[i - 1].id, title: posts[i - 1].data.title },
      older: posts[i + 1] && { id: posts[i + 1].id, title: posts[i + 1].data.title },
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<TreatiseLayout
  id={post.id}
  {...post.data}
  minutes={readingMinutes(post.body)}
  newer={newer}
  older={older}
>
  <Content />
</TreatiseLayout>
