---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
const clean = (p: string) => p.replace(/\/+$/, "") || "/";
const path = clean(Astro.url.pathname);
const target = clean(String(href ?? ""));
const isActive =
  !String(href).includes("#") &&
  (target === "/" ? path === "/" : path === target || path.startsWith(target + "/"));
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? "page" : undefined} {...props}>
  <slot />
</a>
